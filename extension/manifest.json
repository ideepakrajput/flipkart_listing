{
  "manifest_version": 3,
  "name": "GoProVeda Listing Assistant",
  "version": "1.2.2",
  "description": "Reads product label photos with Gemini and drafts Flipkart and Meesho listing fields for review. Never submits anything on its own.",
  "permissions": ["sidePanel", "storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://seller.flipkart.com/*",
    "https://supplier.meesho.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "panel/panel.html" },
  "action": { "default_title": "Open GoProVeda Listing Assistant" },
  "content_scripts": [
    {
      "matches": ["https://seller.flipkart.com/*", "https://supplier.meesho.com/*"],
      "js": ["content/filler.js"],
      "css": ["content/highlight.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["seed/patterns.json"],
      "matches": ["https://seller.flipkart.com/*", "https://supplier.meesho.com/*"]
    }
  ]
}
